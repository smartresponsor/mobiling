#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

mapfile -d '' PHP_FILES < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.php')

if ((${#PHP_FILES[@]} == 0)); then
  exit 0
fi

PHP_BIN="${PHP_BIN:-php}"
FIXER_BIN="${FIXER_BIN:-vendor/bin/php-cs-fixer}"

if [[ -f "$ROOT/.php-cs-fixer.php" ]]; then
  CONFIG_FILE="${CONFIG_FILE:-$ROOT/.php-cs-fixer.php}"
elif [[ -f "$ROOT/.php-cs-fixer.dist.php" ]]; then
  CONFIG_FILE="${CONFIG_FILE:-$ROOT/.php-cs-fixer.dist.php}"
else
  echo "pre-commit: staged PHP files require .php-cs-fixer.php or .php-cs-fixer.dist.php" >&2
  exit 1
fi

if [[ ! -f "$FIXER_BIN" ]]; then
  echo "pre-commit: PHP-CS-Fixer executable not found at $FIXER_BIN" >&2
  exit 1
fi

"$PHP_BIN" -d memory_limit=1G "$FIXER_BIN" fix \
  --config="$CONFIG_FILE" \
  --path-mode=intersection \
  --using-cache=yes \
  --allow-risky=yes \
  -- "${PHP_FILES[@]}"
