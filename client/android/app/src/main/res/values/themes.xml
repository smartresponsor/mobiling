<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OneTasker" parent="android:style/Theme.Material.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/one_tasker_orange</item>
        <item name="android:navigationBarColor">@color/one_tasker_white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">@color/one_tasker_white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="Theme.OneTasker.ActionBar" parent="@android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/one_tasker_orange</item>
        <item name="android:titleTextStyle">@style/Theme.OneTasker.ActionBar.Title</item>
    </style>

    <style name="Theme.OneTasker.ActionBar.Title" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/one_tasker_white</item>
    </style>
</resources>
