{
  "schemaVersion": "2026-06-28.mobile-upstream-contract.v1",
  "consumer": "mobile-edge",
  "upstreamRuntime": "App",
  "upstreamRuntimePort": 8000,
  "mobileEdgePort": 8080,
  "policy": {
    "transport": "mobile-edge must call App runtime as an upstream service and must not expose upstream redirects to native clients.",
    "authority": "App/Symfony components own business logic and payload authority; mobile-edge owns mobile transport and normalization.",
    "vendorId": "mobile-edge treats vendorId as an external string identifier unless an upstream route explicitly documents a numeric-only identifier."
  },
  "routes": [
    {
      "owner": "Navigating",
      "mobileRoute": "GET /navigation/mobile/shell",
      "upstreamRoute": "GET /api/navigation/mobile/shell",
      "status": "declared-in-app"
    },
    {
      "owner": "Carting",
      "mobileRoute": "GET /cart/current",
      "upstreamRoute": "GET /api/cart/current",
      "status": "declared-in-app"
    },
    {
      "owner": "Carting",
      "mobileRoute": "POST /cart/item",
      "upstreamRoute": "POST /api/cart/item",
      "status": "declared-in-app"
    },
    {
      "owner": "Carting",
      "mobileRoute": "POST /cart/checkout-handoff",
      "upstreamRoute": "POST /api/cart/checkout-handoff",
      "status": "declared-in-app"
    },
    {
      "owner": "Attaching",
      "mobileRoute": "GET /attachment",
      "upstreamRoute": "GET /attachments",
      "status": "declared-in-component"
    },
    {
      "owner": "Attaching",
      "mobileRoute": "POST /attachment/link",
      "upstreamRoute": "POST /attachments/attach",
      "status": "declared-in-component"
    },
    {
      "owner": "Cataloging",
      "mobileRoute": "GET /catalog",
      "upstreamRoute": "GET /api/catalog",
      "status": "declared-in-component-pending-green-report"
    },
    {
      "owner": "Cataloging",
      "mobileRoute": "GET /catalog/node/:catalogNodeId",
      "upstreamRoute": "GET /api/catalog/node/{catalogNodeId}",
      "status": "declared-in-component-pending-green-report"
    },
    {
      "owner": "Cataloging",
      "mobileRoute": "GET /catalog/search",
      "upstreamRoute": "GET /api/catalog/search",
      "status": "declared-in-component-pending-green-report"
    },
    {
      "owner": "Localizing",
      "mobileRoute": "GET /locale",
      "upstreamRoute": "GET /api/locale",
      "status": "declared-in-component"
    },
    {
      "owner": "Localizing",
      "mobileRoute": "GET /locale/:code/fallback",
      "upstreamRoute": "GET /api/locale/{code}/fallback",
      "status": "declared-in-component"
    },
    {
      "owner": "Localizing",
      "mobileRoute": "GET \/locale\/translation\/message\/resolve",
      "upstreamRoute": "GET \/api\/locale\/translation\/message\/resolve",
      "status": "declared-in-component"
    },
    {
      "owner": "Vendoring",
      "mobileRoute": "GET /vendor/profile/:vendorId",
      "upstreamRoute": "GET /api/vendor/profile/show/{vendorId}",
      "status": "declared-in-app",
      "appRouteNote": "current App route requires numeric vendorId; mobile-edge smoke uses vendor-demo-001"
    },
    {
      "owner": "Vendoring",
      "mobileRoute": "GET /vendor/summary/:vendorId",
      "upstreamRoute": "GET /api/vendor/summary/show/{vendorId}",
      "status": "declared-in-app"
    },
    {
      "owner": "Vendoring",
      "mobileRoute": "GET /vendor/statement/:vendorId",
      "upstreamRoute": "GET /api/vendor/statement/show/{vendorId}",
      "status": "declared-in-app"
    },
    {
      "owner": "Vendoring",
      "mobileRoute": "GET /vendor/payout/:vendorId",
      "upstreamRoute": "GET /api/vendor/payout/show/{vendorId}",
      "status": "declared-in-app"
    },
    {
      "owner": "Vendoring",
      "mobileRoute": "GET /vendor/transaction/:vendorId",
      "upstreamRoute": "GET /api/vendor/transaction/list/{vendorId}",
      "status": "declared-in-app"
    }
  ]
}
